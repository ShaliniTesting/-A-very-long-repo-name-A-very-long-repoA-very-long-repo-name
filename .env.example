# Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# The .env file will be ignored by git (see .gitignore)

# Server Configuration
# PORT: The port number for the Express.js server to listen on
# If not specified, the server defaults to port 3000
# Common values: 3000 (development), 8080 (alternative), 80 (HTTP - requires elevated permissions)
PORT=3000
